__pycache__

# Written by the pipeline, not by hand. `artifacts/data/sft/train.jsonl` alone is
# ~750 MB, and model/checkpoint directories are pushed to the Hub instead.
artifacts/

# ...except the measurement artifacts every later stage *reads*. budgets.json is a
# real config layer, so a fresh checkout must resolve the measured caps without
# first re-running a multi-minute profile pass over the 701 MB release file.
!artifacts/
!artifacts/data/
artifacts/data/*
!artifacts/data/budgets.json
!artifacts/data/conversion_report.json

# Resource-bounded official-Qwen L4 study: retain only its reproducible evidence.
!artifacts/serving/
artifacts/serving/*
!artifacts/serving/workload-manifest.json
!artifacts/serving/summary.json
!artifacts/serving/report.md
!artifacts/serving/throughput-vs-p95-ttft.png
!artifacts/serving/throughput-vs-p95-tpot.png
!artifacts/serving/matched-fp8-throughput-uplift.png
!artifacts/serving/concurrency-scaling.png
!artifacts/serving/validation/
!artifacts/serving/validation/**
!artifacts/serving/sweeps/
artifacts/serving/sweeps/*
!artifacts/serving/sweeps/direct-vllm029-official-16x2/
!artifacts/serving/sweeps/direct-vllm029-official-16x2/**

# Never commit bearer credentials.
artifacts/serving/vllm-api-key

