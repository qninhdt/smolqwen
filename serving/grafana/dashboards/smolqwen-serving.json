{
  "uid": "smolqwen-serving",
  "title": "smolqwen - single-L4 vLLM serving",
  "description": "vLLM 0.29.0 V1 serving health for the single-L4 benchmark stack. Every panel reads the provisioned Prometheus datasource and only queries verified vLLM V1 series; there is no native HTTP-status metric, so request outcomes are shown via request_success by finish reason and failures are recorded in the benchmark artifacts.",
  "editable": false,
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Traffic",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Token throughput",
      "description": "Prompt (prefill) and generation (decode) token rates.",
      "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "sum(rate(vllm:generation_tokens_total[$__rate_interval]))",
          "legendFormat": "generation tok/s"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "sum(rate(vllm:prompt_tokens_total[$__rate_interval]))",
          "legendFormat": "prompt tok/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Requests running vs waiting",
      "description": "Live scheduler depth: requests in the running batch and requests queued.",
      "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "sum(vllm:num_requests_running)",
          "legendFormat": "running"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "sum(vllm:num_requests_waiting)",
          "legendFormat": "waiting"
        }
      ]
    },
    {
      "type": "row",
      "id": 10,
      "title": "Latency",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "TTFT",
      "description": "Time to first token, p50/p95/p99 from the vLLM histogram.",
      "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "TPOT",
      "description": "Time per output token, p50/p95/p99 from vllm:request_time_per_output_token_seconds.",
      "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:request_time_per_output_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:request_time_per_output_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:request_time_per_output_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Queue time & E2E latency",
      "description": "p95 time spent waiting in the queue and p95 end-to-end request latency.",
      "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:request_queue_time_seconds_bucket[$__rate_interval])))",
          "legendFormat": "queue p95"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "e2e p95"
        }
      ]
    },
    {
      "type": "row",
      "id": 20,
      "title": "KV cache & prefix reuse",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "KV cache usage",
      "description": "Fraction of the paged KV cache in use (1.0 = full).",
      "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "max(vllm:kv_cache_usage_perc)",
          "legendFormat": "kv usage"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "Prefix cache hit ratio",
      "description": "APC effectiveness: hit tokens / queried tokens over the rate window.",
      "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "sum(rate(vllm:prefix_cache_hits_total[$__rate_interval])) / sum(rate(vllm:prefix_cache_queries_total[$__rate_interval]))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 23,
      "title": "Prompt tokens: cached vs total",
      "description": "Prefill tokens served from cache versus total prefill tokens.",
      "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "sum(rate(vllm:prompt_tokens_cached_total[$__rate_interval]))",
          "legendFormat": "cached tok/s"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "sum(rate(vllm:prompt_tokens_total[$__rate_interval]))",
          "legendFormat": "total prompt tok/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 24,
      "title": "Preemptions",
      "description": "Rate of scheduler preemptions. A valid benchmark point has zero preemptions.",
      "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "sum(rate(vllm:num_preemptions_total[$__rate_interval]))",
          "legendFormat": "preemptions/s"
        }
      ]
    },
    {
      "type": "row",
      "id": 30,
      "title": "Reliability",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "panels": []
    },
    {
      "type": "stat",
      "id": 31,
      "title": "Engine scrape health",
      "description": "1 when Prometheus is scraping the authenticated vLLM target.",
      "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "up{job=\"vllm\"}",
          "legendFormat": "up"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 32,
      "title": "Request outcomes by finish reason",
      "description": "Native success counter split by finish reason (stop / length / abort). vLLM 0.29.0 exposes no HTTP-status metric, so overload 503s and client cancellations are recorded in the benchmark/integration artifacts, not here.",
      "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "smolqwen-prometheus" },
          "expr": "sum by (finished_reason) (rate(vllm:request_success_total[$__rate_interval]))",
          "legendFormat": "{{finished_reason}}"
        }
      ]
    },
    {
      "type": "text",
      "id": 33,
      "title": "Reliability notes",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 28 },
      "options": {
        "mode": "markdown",
        "content": "**No native HTTP-status series** in vLLM 0.29.0.\n\n- Overload 503s: bounded by native queue limits; counted in the benchmark/integration artifacts.\n- Client cancellations: surface as the `abort` finish reason above.\n- Container health: `up{job=\"vllm\"}` (left)."
      }
    }
  ]
}
